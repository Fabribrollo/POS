DATABASE_URL="file:./dev.db"
JWT_SECRET="cambiar-en-produccion"
PORT=4000

# Datos del local que se imprimen en el ticket de venta.
NEGOCIO_NOMBRE="POS Indumentaria"
NEGOCIO_DIRECCION=""
NEGOCIO_CUIT=""

# Ruta a un archivo de imagen (png/jpg/ico) para el logo del negocio, relativa
# a la raíz del repo. Se usa como ícono de la ventana de Electron y en el
# sidebar de la app. Vacío = sin logo. Se lee en tiempo de build de Electron
# (apps/electron/esbuild.config.mjs), así que hay que reempaquetar después
# de cambiarla.
NEGOCIO_LOGO=""

# Carpeta local ya sincronizada con Google Drive/Dropbox/OneDrive, para que
# cada backup se exporte también a la nube (el cliente de esa app lo sube
# solo). Dejar vacío para desactivar la exportación a la nube.
BACKUP_CLOUD_DIR=""
